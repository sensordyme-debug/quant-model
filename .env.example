# quant-model environment variables - PLACEHOLDERS ONLY. Nothing here is a real value.
#
# Nothing in this repository loads a .env file: there is no python-dotenv and no parser for
# it. quant_brain reads these names from the process environment (os.environ), so they must
# be set by the shell or by the Task Scheduler action that starts the process. Copy this file
# to `.env` (gitignored, .gitignore line 10) if you want a local record; sourcing it is up to
# you. See docs/DEVELOPMENT.md, "Secrets and .env".

# ---- read by quant_brain/core/mode.py -------------------------------------------------------

# One of: RESEARCH | BACKTEST | VALIDATED | PAPER | PRACTICE.
# HUMAN_APPROVAL and EXECUTION_READY are refused here by design (from_environment raises).
# Unset means RESEARCH, which reaches no adapter at all.
QB_ACCOUNT_MODE=<mode>

# Only read when QB_ACCOUNT_MODE is set. Free text naming the venue and account this
# process is scoped to, e.g. a broker name and a paper/practice account id.
QB_VENUE=<venue-name>
QB_ACCOUNT=<account-id>

# NECESSARY BUT NOT SUFFICIENT. Authority.for_live() also requires (1) an explicit
# i_understand_this_is_real_money=True argument typed in code and (2) a non-empty,
# human-written approval file at live/approvals/<venue>-<account>.md. Setting this alone
# grants nothing (tests/test_qb_mode.py::test_setting_only_the_live_env_var_grants_nothing).
# Leave it empty. Accepted truthy values, for the record: 1, true, yes.
QB_LIVE_TRADING_ENABLED=

# Safety contract for the current research/remediation phase. Executable runners
# also contain a code-level hard disable and never treat environment as consent.
DRY_RUN=true
LIVE_TRADING_ENABLED=false
EXECUTION_ENABLED=false
ORDER_TRANSMISSION_ENABLED=false

# ---- read by quant_brain/brokers/projectx.py ------------------------------------------------
# Credentials are read from the environment ONLY - never from an argument, a repository file,
# or a config object. The adapter cannot place a live order regardless of these values.

PROJECTX_USERNAME=<your-username>
PROJECTX_API_KEY=<your-api-key>

# Optional. The documented default in code is https://api.topstepx.com; set this only to
# point at a different gateway.
PROJECTX_BASE_URL=<base-url>
