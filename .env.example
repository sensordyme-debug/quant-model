# quant-model configuration - PLACEHOLDERS ONLY. Nothing here is a real value.
#
# This is the canonical template. Every variable below names the module that reads it, and
# tests/test_config_safety.py enforces the mapping in both directions: a variable documented
# here with no reader fails the suite, and a configuration variable read by the package and
# not documented here fails it too. That check exists because on 2026-09-14 four of the
# variables in this file were read by nothing at all - a safety contract that looked like
# configuration and was decoration.
#
# WHERE EACH KIND OF VALUE BELONGS
#
#   SECRETS                 live/secrets.env      gitignored, never committed
#   everything else         the process environment, or a local .env you source yourself
#
# Nothing here loads a `.env` file automatically: there is no python-dotenv and no parser for
# one. `quant_brain/core/config.py` DOES read live/secrets.env, with the same format and the
# same precedence scripts/apikeys.py has always used - `KEY=value`, `#` comments, and an
# already-exported environment variable wins over the file.
#
#   python -m quant_brain config doctor
#
# reports what is set, what is missing and what it permits, and prints no value ever.


# =============================================================================================
# SECRETS - live/secrets.env, NOT here, NOT in the environment of a shared machine
# =============================================================================================
# read by quant_brain/core/config.py and quant_brain/brokers/projectx.py
#
# The adapter reads these from the process environment only, never from an argument or a
# config object that might be logged, and holds them in a Credentials object whose __repr__
# and __str__ are overridden so it has no printable form.

PROJECTX_USERNAME=<your-topstepx-username>
PROJECTX_API_KEY=<your-topstepx-api-key>

# read by scripts/apikeys.py - the existing data-vendor keys, unchanged. Listed so this file
# is a complete map of what the repository consumes; they already live in live/secrets.env
# and nothing about them has been altered.
ALPACA_API_KEY=<alpaca-key>
ALPACA_SECRET_KEY=<alpaca-secret>
THETADATA_API_KEY=<theta-key>
FMP_API_KEY=<fmp-key>


# =============================================================================================
# TRADING TARGET - which account. Never guessed, never defaulted, never "the first one".
# =============================================================================================
# read by quant_brain/core/config.py
#
# Not a secret: an account id identifies, it does not authenticate. It is treated as strictly
# required anyway. An unset target is an error and not an invitation to discover one, because
# the failure mode of guessing here is trading the wrong account, which no later check
# recovers from.
#
# Characters are restricted to [A-Za-z0-9-_] and a value outside that is REFUSED rather than
# trimmed: these are pasted from a dashboard and a trailing quote is the usual accident.

TOPSTEP_TARGET_ACCOUNT_ID=<account-id-you-explicitly-chose>


# =============================================================================================
# SAFETY POLICY - all four are read, and all four together are still not sufficient
# =============================================================================================
# read by quant_brain/core/config.py, and through it by scripts/intraday_trader.py,
# scripts/paper_trade.py and quant_brain/brokers/projectx.py
#
# PARSING IS FAIL-CLOSED AND ASYMMETRIC.
#   The three ENABLING flags are true only for an explicit 1, true or yes. Unset, empty or
#   misspelled is false.
#   DRY_RUN is PROTECTIVE and inverts: true unless explicitly 0, false or no. A typo leaves
#   you in a dry run.
#   An unrecognised value is additionally reported as CONFIG_INVALID, so a typo is visible
#   rather than merely survivable.
#
# WHAT THEY DO NOT DO. Setting all four permissively does not enable trading. Transmission
# additionally requires (1) a literal code-level ORDER_TRANSMISSION_ENABLED constant in the
# runner's own source, which configuration cannot reach, and (2) an Authority at
# EXECUTION_READY, which needs QB_LIVE_TRADING_ENABLED below, a typed argument in a diff, and
# a human-written approval file. Eight conditions in four different media.
#
# And even all eight would send nothing today: ProjectXAdapter.submit has no live branch, and
# tests/test_config_safety.py asserts that no configuration whatsoever changes that.

DRY_RUN=true
LIVE_TRADING_ENABLED=false
EXECUTION_ENABLED=false
ORDER_TRANSMISSION_ENABLED=false


# =============================================================================================
# AUTHORITY - what this process is, as opposed to what it may attempt
# =============================================================================================
# read by quant_brain/core/mode.py

# One of: RESEARCH | BACKTEST | VALIDATED | PAPER | PRACTICE.
# HUMAN_APPROVAL and EXECUTION_READY are refused here by design (from_environment raises), so
# no configuration file can select live execution. Unset means RESEARCH, which reaches no
# adapter at all.
QB_ACCOUNT_MODE=<mode>

# Only read when QB_ACCOUNT_MODE is set. Free text naming the venue and account this process
# is scoped to. The approval file for live execution is keyed on this exact pair, so a
# signature for a practice account cannot authorise a funded one.
QB_VENUE=<venue-name>
QB_ACCOUNT=<account-id>

# NECESSARY BUT NOT SUFFICIENT. Authority.for_live() also requires an explicit
# i_understand_this_is_real_money=True argument typed in code, and a non-empty human-written
# approval file at live/approvals/<venue>-<account>.md. Setting this alone grants nothing:
# tests/test_qb_mode.py::test_setting_only_the_live_env_var_grants_nothing.
# Leave it empty. Accepted truthy values, for the record: 1, true, yes.
QB_LIVE_TRADING_ENABLED=


# =============================================================================================
# RUNTIME - non-secret, environment-dependent
# =============================================================================================
# read by quant_brain/core/config.py and quant_brain/brokers/projectx.py
#
# Optional. The documented default in code is https://api.topstepx.com; set this only to
# point at a different gateway.
PROJECTX_BASE_URL=<base-url>
