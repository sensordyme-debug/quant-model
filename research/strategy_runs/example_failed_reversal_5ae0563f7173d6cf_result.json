 "spec": {
  "name": "example_failed_reversal",
  "instrument": "MNQ",
  "timeframe": "1min",
  "signal_name": "failed_reversal_signal",
  "signal_source": "def failed_reversal_signal(X):\n    \"\"\"Long when an upside extension retraces below the 95th-percentile level; mirrored.\"\"\"\n    orp = np.nan_to_num(np.asarray(X[\"opening_range_pos\"], dtype=float), nan=0.0)\n    mins = np.nan_to_num(np.asarray(X[\"minutes_from_open\"], dtype=float), nan=0.0)\n    live = mins > 45\n    prev = np.concatenate(([0.0], orp[:-1]))\n    pos = np.zeros(len(orp), dtype=float)\n    pos[live & (prev > HI) & (orp < HI)] = 1.0\n    pos[live & (prev < LO) & (orp > LO)] = -1.0\n    return pos\n",
  "exit": {
   "stop_atr": null,
   "target_r": null,
   "structural_stop": false,
   "trail_atr": null,
   "breakeven_at_r": null,
   "time_stop_bars": null,
   "use_invalidation": true
  },
  "sizing": {
   "contracts": 1,
   "max_contracts": null,
   "max_micro_equivalent": 50
  },
  "session": {
   "open_et": "09:30",
   "close_et": "16:00",
   "warmup_bars": 45,
   "last_entry_bar": null
  },
  "cost": {
